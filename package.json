{
  "name": "herdview",
  "version": "0.1.3",
  "description": "Embeddable terminal pane component for herdr-core: HerdConnection + HerdView, one connection many views, zero built-in UI, ghostty-web rendering",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./json-lines": "./json-lines.js",
    "./json-lines.js": "./json-lines.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "json-lines.js",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check json-lines.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ghostty-web": "^0.4.0"
  },
  "keywords": [
    "herdr",
    "terminal",
    "ghostty",
    "web-terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmlinux/herdview.git"
  },
  "homepage": "https://github.com/lmlinux/herdview#readme",
  "bugs": {
    "url": "https://github.com/lmlinux/herdview/issues"
  }
}
